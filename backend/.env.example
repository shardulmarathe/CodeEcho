# Stanford llm.stanford.edu key (sk-...)
GEMINI_API_KEY=

# Stanford Gemini proxy — same as gemini-cli uses
GOOGLE_GEMINI_BASE_URL=https://api.llm.stanford.edu

# Model for text analysis (fillers, transitions, debug tests)
GEMINI_MODEL=gemini-2.5-flash

# Model for audio transcription — use a multimodal-capable model (e.g. gemini-2.5-pro)
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Budget cap in USD — single GLOBAL cap on estimated LLM spend, shared by all users
API_BUDGET_CAP_USD=3.0

# --- Only for UIT AI API Gateway keys (NOT llm.stanford.edu keys) ---
# LLM_BASE_URL=https://aiapi-prod.stanford.edu/v1

# --- Only for Google AI Studio keys (AIza...) ---
# Leave GOOGLE_GEMINI_BASE_URL empty

# Supabase (Postgres + Storage + pgvector). Backend-only secret — never expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio

# Clerk auth (https://dashboard.clerk.com -> API Keys / Frontend API).
# CLERK_ISSUER is your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# CLERK_JWKS_URL=            # optional; auto-derived from CLERK_ISSUER if blank
# CLERK_SECRET_KEY=          # optional; only for Clerk Backend API calls

FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
CLIPS_DIR=./clips

# Debug routes (GET /api/debug/gemini/ping, POST /api/debug/gemini/text).
# UNAUTHENTICATED — they let anyone spend your LLM budget. Default is OFF (false).
# Set to true ONLY for local development; leave false/unset in any deployed environment.
ENABLE_DEBUG_ROUTES=false
