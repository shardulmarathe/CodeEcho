# Stanford llm.stanford.edu key (sk-...)
GEMINI_API_KEY=

# Stanford Gemini proxy — same as gemini-cli uses
GOOGLE_GEMINI_BASE_URL=https://api.llm.stanford.edu

# Fast text tasks: fillers, transitions, question generation, debug tests
GEMINI_MODEL=gemini-2.5-flash

# Answer scoring — reasoning-heavy rubric task; pro + thinking budget by default
GEMINI_SCORING_MODEL=gemini-2.5-pro
# GEMINI_SCORING_THINKING_BUDGET=2048     # >0 reasons; 0 off; <0 model default
# GEMINI_SCORING_MAX_OUTPUT_TOKENS=12288

# Cross-encoder reranker — reorders retrieved RAG chunks for precision (big win for coding
# guidance). Loads ~150-200MB ONNX locally. Recommended ON for local dev; set false on
# Render free tier (512MB) — hybrid pgvector + keyword retrieval still runs without it.
RERANK_ENABLED=true

# --- Azure OpenAI (shared resource — Whisper STT + embeddings) ---
# Create a resource at https://portal.azure.com and deploy:
#   - whisper (speech-to-text)
#   - text-embedding-3-small (RAG embeddings)
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
#
# Whisper speech-to-text (required for transcription).
# Endpoint/key fall back to AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_API_KEY when blank.
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
# AZURE_OPENAI_WHISPER_ENDPOINT=            # optional override
# AZURE_OPENAI_WHISPER_API_KEY=             # optional override
# AZURE_OPENAI_WHISPER_API_VERSION=2024-06-01   # word timestamps need >= 2024-06-01

# Budget cap in USD — single GLOBAL cap on estimated LLM spend, shared by all users
API_BUDGET_CAP_USD=3.0

# --- Only for UIT AI API Gateway keys (NOT llm.stanford.edu keys) ---
# LLM_BASE_URL=https://aiapi-prod.stanford.edu/v1

# --- Only for Google AI Studio keys (AIza...) ---
# Leave GOOGLE_GEMINI_BASE_URL empty

# Supabase (Postgres + Storage + pgvector). Backend-only secret — never expose the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=audio

# Clerk auth (https://dashboard.clerk.com -> API Keys / Frontend API).
# CLERK_ISSUER is your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# CLERK_JWKS_URL=            # optional; auto-derived from CLERK_ISSUER if blank
# CLERK_SECRET_KEY=          # optional; only for Clerk Backend API calls

FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
CLIPS_DIR=./clips

# Debug routes (GET /api/debug/gemini/ping, POST /api/debug/gemini/text).
# UNAUTHENTICATED — they let anyone spend your LLM budget. Default is OFF (false).
# Set to true ONLY for local development; leave false/unset in any deployed environment.
ENABLE_DEBUG_ROUTES=false

# --- RAG memory tuning (important on Render free tier = 512MB RAM) ---
# Hybrid retrieval (pgvector + full-text in Supabase) is cheap. The memory spike comes
# from loading local ONNX models in-process on the first scored answer:
#   - BAAI/bge-base-en-v1.5 embeddings (~300MB)
#   - ms-marco-MiniLM-L-6-v2 cross-encoder reranker (~100MB)
# RERANK_ENABLED=false skips the reranker. Cloud embeddings skip local ONNX (~300MB):
#   AZURE_OPENAI_ENDPOINT, AZURE_OPENAI_API_KEY, AZURE_OPENAI_EMBEDDING_DEPLOYMENT
#   or EMBEDDING_API_KEY (Google). Ingest and query must use the same provider.
# RAG_ENABLED=false
# RERANK_ENABLED=false
# EMBEDDING_API_KEY=
